# ==============================================================================
# PRAMAAN Environment Configuration Example
# ==============================================================================
# Copy this file to .env in local development or configure these environment
# variables in your Render / hosting provider dashboard.
# NEVER commit real private keys or production secrets to source control.

# Server Host and Port (Render dynamically sets $PORT in production)
HOST=0.0.0.0
PORT=8000

# Allowed Frontend URLs for CORS
# In production, set this to your Vercel URL (e.g. https://pramaan-app.vercel.app)
# Comma-separated values are supported.
FRONTEND_URL=https://pramaan-app.vercel.app,http://localhost:5500
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://localhost:5173

# Frontend API base URL (for frontend reference when configuring environment)
API_BASE_URL=https://pramaan-backend.onrender.com/api/v1

# Storage Paths (relative to backend directory or absolute paths on server)
DATABASE_PATH=./pramaan.db
UPLOAD_DIR=./uploads

# Cryptographic Key Paths (keys are automatically generated if not present)
PRIVATE_KEY_PATH=./app/keys/pramaan_ecdsa_private.pem
PUBLIC_KEY_PATH=./app/keys/pramaan_ecdsa_public.pem
